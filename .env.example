# Provider LLM ativo: openai | groq | openrouter | ollama | anthropic
LLM_PROVIDER=groq

# OpenAI-Compatible (Groq gratuito, OpenRouter gratuito, Ollama local ou OpenAI)
# Groq (tier gratuito):        OPENAI_BASE_URL=https://api.groq.com/openai/v1 | OPENAI_MODEL=llama-3.3-70b-versatile
# OpenRouter (modelos :free):  OPENAI_BASE_URL=https://openrouter.ai/api/v1 | OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Ollama (100% local):         OPENAI_BASE_URL=http://127.0.0.1:11434/v1    | OPENAI_MODEL=qwen2.5-coder:7b
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_MAX_TOKENS=4096

# Anthropic (opcional, caso LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# MySQL Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=claude_code
DB_USERNAME=root
DB_PASSWORD=

# Agent Defaults
PERMISSION_MODE=ask
COMMAND_TIMEOUT=30
